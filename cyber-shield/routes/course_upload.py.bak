from flask import Blueprint, request, jsonify
import sqlite3
import os

course_upload_bp = Blueprint('course_upload', __name__)
DB_PATH = os.path.join(os.path.dirname(__file__), '..', 'cyber-shield-linkguard.db')

@course_upload_bp.route('/upload', methods=['POST'])
def upload_course():
    data = request.get_json()
    required_fields = [
        'id', 'title', 'description', 'full_description', 'category', 'duration',
        'instructor', 'image', 'youtube_url', 'intro_stakes', 'intro_reflection',
        'sections_json', 'activities_json', 'lessons_json', 'status',
        'students', 'rating', 'created_at', 'updated_at'
    ]
    for field in required_fields:
        if field not in data:
            return jsonify({'error': f'Missing field: {field}'}), 400
    try:
        conn = sqlite3.connect(DB_PATH)
        cur = conn.cursor()
        cur.execute('''
            INSERT INTO course (
                id, title, description, full_description, category, duration, instructor, image, youtube_url,
                intro_stakes, intro_reflection, sections_json, activities_json, lessons_json, status, students, rating, created_at, updated_at
            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        ''', (
            data['id'], data['title'], data['description'], data['full_description'], data['category'], data['duration'],
            data['instructor'], data['image'], data['youtube_url'], data['intro_stakes'], data['intro_reflection'],
            data['sections_json'], data['activities_json'], data['lessons_json'], data['status'],
            data['students'], data['rating'], data['created_at'], data['updated_at']
        ))
        conn.commit()
        conn.close()
        return jsonify({'success': True}), 201
    except Exception as e:
        return jsonify({'error': str(e)}), 500
